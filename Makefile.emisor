MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
TOOL := $(MAKEFILE_DIR)tools/terminal_chat.py

PYTHON ?= python3
ENCODING ?= utf-8
CRC ?= smbus
LANES ?= 3
SEQ_START ?= 0
QUIET ?= --quiet
MENSAJE ?= Hola, mundo
SALIDA ?= frames.jsonl
CORRUPT_FRAME ?=

CORRUPT_ARG := $(if $(strip $(CORRUPT_FRAME)),--corrupt-frame $(CORRUPT_FRAME),)
TX := $(PYTHON) $(TOOL) tx --encoding $(ENCODING) --crc $(CRC) --lanes $(LANES) --seq-start $(SEQ_START) $(QUIET) $(CORRUPT_ARG)

.PHONY: enviar interactivo archivo tramas ayuda limpiar

enviar:
	@printf '%s\n' '$(MENSAJE)' | $(TX)

interactivo:
	@$(TX)

archivo:
	@printf '%s\n' '$(MENSAJE)' | $(TX) > $(SALIDA)
	@printf 'Frames guardados en %s\n' '$(SALIDA)'

tramas:
	@printf '%s\n' '$(MENSAJE)' | $(PYTHON) $(TOOL) tx --encoding $(ENCODING) --crc $(CRC) --lanes $(LANES) --seq-start $(SEQ_START) $(CORRUPT_ARG) >/dev/null

ayuda:
	@printf '%s\n' 'Makefile del emisor'
	@printf '%s\n' ''
	@printf '%s\n' 'Objetivos:'
	@printf '%s\n' '  make -f Makefile.emisor enviar       Genera los frames de MENSAJE en stdout'
	@printf '%s\n' '  make -f Makefile.emisor interactivo  Lee lineas desde la terminal'
	@printf '%s\n' '  make -f Makefile.emisor archivo      Guarda los frames en SALIDA'
	@printf '%s\n' '  make -f Makefile.emisor tramas       Muestra las tramas generadas'
	@printf '%s\n' '  make -f Makefile.emisor limpiar      Borra el archivo de salida'
	@printf '%s\n' ''
	@printf '%s\n' 'Variables:'
	@printf '%s\n' '  PYTHON=$(PYTHON)'
	@printf '%s\n' '  ENCODING=$(ENCODING)'
	@printf '%s\n' '  CRC=$(CRC)'
	@printf '%s\n' '  LANES=$(LANES)'
	@printf '%s\n' '  SEQ_START=$(SEQ_START)'
	@printf '%s\n' '  QUIET=$(QUIET)'
	@printf '%s\n' '  MENSAJE=$(MENSAJE)'
	@printf '%s\n' '  SALIDA=$(SALIDA)'
	@printf '%s\n' '  CORRUPT_FRAME=$(CORRUPT_FRAME)'
	@printf '%s\n' ''
	@printf '%s\n' 'Ejemplos:'
	@printf '%s\n' '  make -f Makefile.emisor enviar MENSAJE="Hola, señor"'
	@printf '%s\n' '  make -f Makefile.emisor archivo MENSAJE="Hola" SALIDA=frames.jsonl'
	@printf '%s\n' '  make -f Makefile.emisor tramas MENSAJE="abc" CORRUPT_FRAME=1'

limpiar:
	@$(RM) $(SALIDA)
	@printf 'Eliminado %s\n' '$(SALIDA)'
