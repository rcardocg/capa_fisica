MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
TOOL := $(MAKEFILE_DIR)tools/terminal_chat.py

PYTHON ?= python3
ENCODING ?= utf-8
CRC ?= smbus
LANES ?= 3
QUIET ?= --quiet
ENTRADA ?= frames.jsonl
FIFO ?= /tmp/phy_link
RX := $(PYTHON) $(TOOL) rx --encoding $(ENCODING) --crc $(CRC) --lanes $(LANES) $(QUIET)

.PHONY: recibir interactivo escuchar fifo borrar-fifo ayuda limpiar

recibir:
	@$(RX) < $(ENTRADA)

interactivo:
	@$(RX)

fifo:
	@test -p $(FIFO) || mkfifo $(FIFO)

escuchar: fifo
	@$(RX) < $(FIFO)

borrar-fifo:
	@$(RM) $(FIFO)
	@printf 'Eliminado %s\n' '$(FIFO)'

ayuda:
	@printf '%s\n' 'Makefile del receptor'
	@printf '%s\n' ''
	@printf '%s\n' 'Objetivos:'
	@printf '%s\n' '  make -f Makefile.receptor recibir     Lee frames desde ENTRADA'
	@printf '%s\n' '  make -f Makefile.receptor interactivo Lee frames desde la terminal'
	@printf '%s\n' '  make -f Makefile.receptor escuchar    Escucha por el FIFO'
	@printf '%s\n' '  make -f Makefile.receptor borrar-fifo Borra el FIFO'
	@printf '%s\n' '  make -f Makefile.receptor limpiar     Borra la entrada y el FIFO'
	@printf '%s\n' ''
	@printf '%s\n' 'Variables:'
	@printf '%s\n' '  PYTHON=$(PYTHON)'
	@printf '%s\n' '  ENCODING=$(ENCODING)'
	@printf '%s\n' '  CRC=$(CRC)'
	@printf '%s\n' '  LANES=$(LANES)'
	@printf '%s\n' '  QUIET=$(QUIET)'
	@printf '%s\n' '  ENTRADA=$(ENTRADA)'
	@printf '%s\n' '  FIFO=$(FIFO)'
	@printf '%s\n' ''
	@printf '%s\n' 'Ejemplos:'
	@printf '%s\n' '  make -f Makefile.receptor recibir ENTRADA=frames.jsonl'
	@printf '%s\n' '  make -f Makefile.receptor escuchar FIFO=/tmp/phy_link'
	@printf '%s\n' '  make -f Makefile.receptor interactivo QUIET='

limpiar:
	@$(RM) $(ENTRADA) $(FIFO)
	@printf 'Eliminados %s y %s\n' '$(ENTRADA)' '$(FIFO)'
