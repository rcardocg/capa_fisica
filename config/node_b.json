{
  "node": "B",
  "role": "remote",
  "reachable_from_pc": false,
  "tx": {
    "clock": { "gpio": 45, "pin": "P8_11", "direction": "out" },
    "data": { "gpio": 60, "pin": "P9_12", "medium": "luz" }
  },
  "rx": {
